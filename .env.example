# Backend Environment Template (.env.example)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
# Frontend Application Base URL for SSO Redirects (Local: http://localhost:8080, Prod: https://lms.vibesandbox.live)
FRONTEND_URL=https://lms.vibesandbox.live

# VibeConnect Integration (Phase 5C)
VIBECONNECT_API_BASE_URL=http://localhost:8100
VIBECONNECT_M2M_SECRET=your-vibeconnect-m2m-secret
VIBECONNECT_LAUNCH_GRANT_SECRET=
VIBECONNECT_SSO_CLIENT_ID=pilot_lms_client
VIBECONNECT_SSO_AUDIENCE=vibeconnect-lms
